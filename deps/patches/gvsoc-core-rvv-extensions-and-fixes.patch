+    return vmvnr_v_exec(iss, insn, pc, 1);
+}
+
+static inline iss_reg_t vmv2r_v_exec(Iss *iss, iss_insn_t *insn, iss_reg_t pc)
+{
+    return vmvnr_v_exec(iss, insn, pc, 2);
+}
+
+static inline iss_reg_t vmv4r_v_exec(Iss *iss, iss_insn_t *insn, iss_reg_t pc)
+{
+    return vmvnr_v_exec(iss, insn, pc, 4);
+}
+
+static inline iss_reg_t vmv8r_v_exec(Iss *iss, iss_insn_t *insn, iss_reg_t pc)
+{
+    return vmvnr_v_exec(iss, insn, pc, 8);
+}
