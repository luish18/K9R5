+    return vw_op_wx_exec(iss, insn, pc, true, false);
+}
+
+// Whole-register moves: copy nr full vector registers, independent of vl.
+static inline iss_reg_t vmvnr_v_exec(Iss *iss, iss_insn_t *insn, iss_reg_t pc, int nr)
