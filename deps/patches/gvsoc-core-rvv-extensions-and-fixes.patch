+// VXUNARY0 integer extension: vd[i] = extend(vs2[i]), where the source
+// element width is SEW/factor and the destination element width is SEW.
+static inline iss_reg_t vext_common_exec(Iss *iss, iss_insn_t *insn, iss_reg_t pc,
+    unsigned int factor, bool is_signed)
+{
+    unsigned int sewb = iss->vector.sewb;
+    unsigned int lmul = iss->vector.lmul;
+    unsigned int src_sewb = sewb / factor;
+    for (unsigned int i=VSTART; i<VEND; i++)
+    {
+        if (velem_is_active(iss, i, UIM_GET(0)))
+        {
+            uint64_t raw = velem_get_value(iss, REG_IN(0), i, src_sewb, lmul);
+            uint64_t res = is_signed ? (uint64_t)get_signed_value(raw, 64, src_sewb * 8)
+                                     : raw;
+            velem_set_value(iss, REG_OUT(0), i, sewb, res);
+        }
+    }
+    return iss_insn_next(iss, insn, pc);
+}
+
+static inline iss_reg_t vzext_vf8_exec(Iss *iss, iss_insn_t *insn, iss_reg_t pc)
+{
+    return vext_common_exec(iss, insn, pc, 8, false);
+}
+
+static inline iss_reg_t vsext_vf8_exec(Iss *iss, iss_insn_t *insn, iss_reg_t pc)
+{
+    return vext_common_exec(iss, insn, pc, 8, true);
+}
+
+static inline iss_reg_t vzext_vf4_exec(Iss *iss, iss_insn_t *insn, iss_reg_t pc)
+{
+    return vext_common_exec(iss, insn, pc, 4, false);
+}
+
+static inline iss_reg_t vsext_vf4_exec(Iss *iss, iss_insn_t *insn, iss_reg_t pc)
+{
+    return vext_common_exec(iss, insn, pc, 4, true);
+}
+
+static inline iss_reg_t vzext_vf2_exec(Iss *iss, iss_insn_t *insn, iss_reg_t pc)
+{
+    return vext_common_exec(iss, insn, pc, 2, false);
+}
+
+static inline iss_reg_t vsext_vf2_exec(Iss *iss, iss_insn_t *insn, iss_reg_t pc)
+{
+    return vext_common_exec(iss, insn, pc, 2, true);
+}
+
+// Widening add/sub with wide first operand: vd(2*SEW) = vs2(2*SEW) op vs1(SEW).
+// Format_OPV: REG_IN(0) = vs1 (narrow), REG_IN(1) = vs2 (wide).
+static inline iss_reg_t vw_op_wv_exec(Iss *iss, iss_insn_t *insn, iss_reg_t pc,
+    bool is_sub, bool is_signed)
+{
+    unsigned int sewb = iss->vector.sewb;
+    unsigned int lmul = iss->vector.lmul;
+    for (unsigned int i=VSTART; i<VEND; i++)
+    {
+        if (velem_is_active(iss, i, UIM_GET(0)))
+        {
+            uint64_t narrow_raw = velem_get_value(iss, REG_IN(0), i, sewb, lmul);
+            int64_t narrow = is_signed ? get_signed_value(narrow_raw, 64, sewb * 8)
+                                       : (int64_t)narrow_raw;
+            int64_t wide = (int64_t)velem_get_value(iss, REG_IN(1), i, 2 * sewb, lmul);
+            int64_t res = is_sub ? wide - narrow : wide + narrow;
+            velem_set_value(iss, REG_OUT(0), i, 2 * sewb, res);
+        }
+    }
+    return iss_insn_next(iss, insn, pc);
+}
+
+static inline iss_reg_t vw_op_wx_exec(Iss *iss, iss_insn_t *insn, iss_reg_t pc,
+    bool is_sub, bool is_signed)
+{
+    unsigned int sewb = iss->vector.sewb;
+    unsigned int lmul = iss->vector.lmul;
+    int64_t narrow = is_signed ? get_signed_value(RVV_REG_GET(0), 64, sewb * 8)
+                               : (int64_t)(RVV_REG_GET(0) & (sewb == 8 ? ~0ULL : ((1ULL << (sewb * 8)) - 1)));
+    for (unsigned int i=VSTART; i<VEND; i++)
+    {
+        if (velem_is_active(iss, i, UIM_GET(0)))
+        {
+            int64_t wide = (int64_t)velem_get_value(iss, REG_IN(1), i, 2 * sewb, lmul);
+            int64_t res = is_sub ? wide - narrow : wide + narrow;
+            velem_set_value(iss, REG_OUT(0), i, 2 * sewb, res);
+        }
+    }
+    return iss_insn_next(iss, insn, pc);
+}
+
+static inline iss_reg_t vwadd_wv_exec(Iss *iss, iss_insn_t *insn, iss_reg_t pc)
